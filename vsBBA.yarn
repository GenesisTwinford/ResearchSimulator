// 選択直後に敗北判定。相打ちも主人公の敗北を優先する。
<<if $san <= 0>>
    <<jump ED2_3>>
<<endif>>
<<if $bba_san <= 0>>
    <<set $bba_san to 0>>
    <<jump BBA_Result>>
<<endif>>
<<jump Q2_5>>
