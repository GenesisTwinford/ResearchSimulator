    おばちゃん: やだ、今はただのおばちゃんよ！ 忘れてちょうだい。
    （おばちゃんの過去に、少しだけ触れた。）
    <<set $bba_san to $bba_san - 1>>
    <<set $bba_past to true>>

// 選択直後に敗北判定。相打ちも主人公の敗北を優先する。
<<if $san <= 0>>
    <<jump ED2_3>>
<<endif>>
<<if $bba_san <= 0>>
    <<set $bba_san to 0>>
    <<jump BBA_Result>>
<<endif>>
<<jump Q2_6>>
===

